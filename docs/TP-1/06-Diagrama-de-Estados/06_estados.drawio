        <!-- Creada -> En espera -->
        <mxCell id="t1" value="encolarAccion() /&#xa;asignarID()" style="endArrow=open;endSize=12;html=1;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;labelBackgroundColor=#111111;spacing=4;" edge="1" parent="1" source="st_creada" target="st_espera">
