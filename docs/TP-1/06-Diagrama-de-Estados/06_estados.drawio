        <!-- En espera -> En proceso -->
        <mxCell id="t2" value="despacharAccion() /&#xa;reservarRecursos()" style="endArrow=open;endSize=12;html=1;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;labelBackgroundColor=#111111;spacing=4;" edge="1" parent="1" source="st_espera" target="st_proceso">
          <mxGeometry width="160" relative="1" as="geometry" />
