        <!-- Transiciones con Eventos, Condiciones y Acciones limpias -->
        <!-- Start -> Creada -->
        <mxCell id="t0" value="solicitarAccion()" style="endArrow=open;endSize=12;html=1;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;labelBackgroundColor=#111111;spacing=4;" edge="1" parent="1" source="init" target="st_creada">
